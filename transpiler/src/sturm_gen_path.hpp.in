#pragma once

// sturm_gen_path.hpp — generated from transpiler/src/sturm_gen_path.hpp.in
// by configure_file (transpiler/CMakeLists.txt).
//
// Single source of truth for the build's `sturm_gen/` directory path.
// Consumed by `transpiler/tests/test_sturm_gen_clean.cpp` (sturm-7t85.4 /
// G4) so the test resolves the correct directory regardless of which
// build tree it was configured under (build/, build_mac/, build_linux/,
// ...). Risk R7 in `docs/archive/prd_qint_alias_completion.md` §9.5: any
// build-dir drift between configure-time and run-time produces a
// compile-time error here, not a silent test pass.
//
// The recorded path is `${CMAKE_BINARY_DIR}/sturm_gen` — the same
// directory layout `add_quantum_executable()` writes to in both plugin
// mode (mirror via `dump-to=<path>`) and dump mode (per-source
// `add_custom_command` output).

namespace sturm::transpile::testing {

inline constexpr const char* kSturmGenDir = "@STURM_GEN_DIR@";

}  // namespace sturm::transpile::testing
